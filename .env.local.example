# =====================================================================
# Backend ContaboxPro core2 — DEV LOCAL
# (correr el backend antes que el frontend)
#
# Identity   : https://localhost:7125  (auth, users, taxpayers, ...)
# Procedures : https://localhost:7165  (declaration, vault, cfdi, ...)
# Reports    : https://localhost:7126  (dashboards)
# Scrappers  : https://localhost:7042
# =====================================================================

# URL principal (la que usa apiConfig.BASE_URL)
NEXT_PUBLIC_API_URL=https://localhost:7125

# Bases por microservicio (sobrescriben los defaults de apiUrls.ts)
NEXT_PUBLIC_API_BASE_IDENTITY=https://localhost:7125
NEXT_PUBLIC_API_BASE_PROCEDURES=https://localhost:7165
NEXT_PUBLIC_API_BASE_REPORTS=https://localhost:7126
NEXT_PUBLIC_API_BASE_SCRAPPERS=https://localhost:7042

# Solo dev: aceptar cert HTTPS autofirmado del backend de .NET.
# NUNCA en producción.
NODE_TLS_REJECT_UNAUTHORIZED=0

# =====================================================================
# Supabase (DEPRECATED — el kit Bearer reemplazó la auth principal,
# pero algunos archivos aún consultan tablas Supabase. Mientras no se
# migren, deja estas variables o la app fallará al consultar tablas).
# =====================================================================
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =====================================================================
# Stripe (sin cambios — sigue como estaba)
# =====================================================================
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
