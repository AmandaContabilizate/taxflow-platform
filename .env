
#
# CONVENCIÓN: ninguna variable de este archivo lleva el prefijo
# NEXT_PUBLIC_ salvo que (a) el valor deba diferir entre STG/Producción Y
# (b) se lea directo en código de cliente sin poder pasar por un server
# round-trip. NEXT_PUBLIC_ se hornea en el bundle del cliente en build time
# — si un valor así difiere por entorno, un solo build no puede servir a
# ambos. Todo lo demás debe ser server-only para poder cambiarse en
# Application Settings (Azure) sin necesitar rebuild.
# =====================================================================

# URL principal (la que usa apiConfig.BASE_URL)
API_URL=https://127.0.0.1:7125

# Bases por microservicio (DEV LOCAL)
API_BASE_IDENTITY=https://localhost:7125/api
API_BASE_PROCEDURES=https://localhost:44380/api
API_BASE_REPORTS=https://localhost:7126/api

NEXT_PUBLIC_API_BASE_PROCEDURES=https://localhost:44380/api
# API_BASE_IDENTITY=https://contaboxpro-stg-identity-bfcrgbe8ffgxarb0.southcentralus-01.azurewebsites.net/api
# API_BASE_PROCEDURES=https://contaboxpro-stg-backend-procedures.azurewebsites.net/api
# API_BASE_REPORTS=https://contaboxpro-stg-backend-reports.azurewebsites.net/api

API_PUBLIC_FRONTEND_URL = http://localhost:3000/
# Solo dev: aceptar cert HTTPS autofirmado del backend de .NET.
# NUNCA en producción.
NODE_TLS_REJECT_UNAUTHORIZED=0

# Identifica a este frontend ante el backend en las rutas OAuth/onboarding
# que aceptan {systemOriginId?} (ej. /auth/google/4, /users/SendCode/4).
# Para taxflow-platform el valor asignado es 4.
SYSTEM_ORIGIN_ID=4

# =====================================================================
# Stripe (opcional — solo si activas Checkout en /planes)
# =====================================================================
STRIPE_SECRET_KEY= some_test_secret_key
STRIPE_WEBHOOK_SECRET= some_test_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_51RHsksPqHi2v2kShPQu8LV0ipH3F1IMvmgX2XL7sCkO9JCXA6MZJ7Kvq7wNxsVb1x71dQNGAXDv4MqpVaSBZiAT4005VHX1BSW

# Enlaces al dashboard de Stripe desde el modal de ventas del contador:
# https://dashboard.stripe.com/{cuenta}/{test/}payments/{pi_...}
# Deja el modo vacio (o distinto de "test") cuando apuntes a produccion.
NEXT_PUBLIC_STRIPE_DASHBOARD_ACCOUNT=acct_1RHsksPqHi2v2kSh
NEXT_PUBLIC_STRIPE_DASHBOARD_MODE=test
